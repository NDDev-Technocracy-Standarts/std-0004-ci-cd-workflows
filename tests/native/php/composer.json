{
  "name": "example/native-checksum",
  "description": "Native PHP checksum fixture",
  "type": "library",
  "license": "AGPL-3.0-only",
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "NativeFixture\\": "src/"
    }
  },
  "scripts": {
    "lint": [
      "php -l src/Checksum.php",
      "php -l tests/ChecksumTest.php"
    ],
    "analyse": "phpstan analyse --no-progress --level=max src tests"
  },
  "archive": {
    "exclude": [
      "vendor",
      ".nddev-reports"
    ]
  }
}
