{
  "python": {
    "manifests": [
      "pyproject.toml",
      "requirements*.txt",
      "requirements/*.txt"
    ],
    "stages": {
      "setup": [
        "uv",
        "sync",
        "--locked"
      ],
      "toolchain": "uv --version && uv run python --version",
      "format": [
        "uv",
        "run",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "lint": [
        "uv",
        "run",
        "ruff",
        "check",
        "."
      ],
      "type": [
        "uv",
        "run",
        "basedpyright"
      ],
      "test": [
        "uv",
        "run",
        "pytest",
        "--junitxml=.nddev-reports/pytest.xml",
        "--cov",
        "--cov-report=xml:.nddev-reports/coverage.xml"
      ],
      "build": [
        "uv",
        "build"
      ],
      "consumer": [
        "@library",
        "package-check"
      ]
    },
    "report": {
      "kind": "junit",
      "path": ".nddev-reports/pytest.xml"
    },
    "dependencies": {
      "consumer": [
        "build"
      ]
    },
    "waivable_stages": [
      "build",
      "consumer"
    ]
  },
